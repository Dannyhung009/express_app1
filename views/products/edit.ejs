<!DOCTYPE html>
<html lang="zh-TW">

<head>

    <meta charset="UTF-8">

    <title>修改商品</title>

</head>

<body>

    <h1>修改商品</h1>

    <form
        action="/products/edit/<%= product.ProductID %>"
        method="POST">

        <div>

            <label>商品編號：</label>

            <input
                type="text"
                value="<%= product.ProductID %>"
                disabled>

        </div>

        <br>

        <div>

            <label>商品名稱：</label>

            <input
                type="text"
                name="ProductName"
                value="<%= product.ProductName %>"
                required>

        </div>

        <br>

        <div>

            <label>單價：</label>

            <input
                type="number"
                name="UnitPrice"
                value="<%= product.UnitPrice %>"
                step="0.01"
                required>

        </div>

        <br>

        <div>

            <label>庫存：</label>

            <input
                type="number"
                name="UnitsInStock"
                value="<%= product.UnitsInStock %>"
                required>

        </div>

        <br>

        <button type="submit">
            儲存修改
        </button>

        <a href="/products">
            返回
        </a>

    </form>

</body>

</html>